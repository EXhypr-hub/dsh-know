# ── 操作系统产生的东西 ────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# Windows 保留设备名（不是真文件，读取会无限阻塞，绝不能提交）
CON
PRN
AUX
NUL
COM1
COM2
COM3
COM4
LPT1
LPT2

# ── 编辑器 ──────────────────────────────────────
.vscode/
.idea/

# ── 日志与临时文件 ───────────────────────────────
*.log
*.tmp
.cache/
coverage/

# ── 敏感信息（绝对不能传）────────────────────────
.env
.env.*
*.key
*.pem

# ── Git 备份包（含旧历史，不公开）────────────────
*.bundle

# ── 内部文档（不公开）──────────────────────────────
# 个人计划书含本机环境信息，仅本地保留，不进版本库
/docs/

# ── 插件依赖（P6 发布时再入库）──────────────────────
# 现在为了仓库轻量不提交；P6 打包发布时会改为随仓库分发，
# 让使用者「下载即用、无需联网装依赖」。
dsh-knowbase/node_modules/



# 编辑过程中的临时备份
*.bak-*

# 发布产物（由 scripts/build-release.mjs 生成，不入库）
release/

# 发布产物误放到根目录时也要挡住
*.zip
*.tgz
