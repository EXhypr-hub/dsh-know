{
  "name": "dsh-knowbase",
  "version": "0.6.0",
  "private": true,
  "description": "DSH 本地知识库插件：文档导入、语义检索、权威来源采集",
  "type": "module",
  "license": "MIT",
  "author": "EXhypr-hub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EXhypr-hub/dsh-know.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@napi-rs/canvas": "^1.1.1",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "selftest": "node scripts/selftest.mjs",
    "slim": "node scripts/slim.mjs",
    "slim:restore": "node scripts/slim.mjs --restore",
    "slim:check": "node scripts/slim.mjs --dry-run"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "scripts/slim.mjs"
  ],
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.1.7-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "rag",
    "embedding",
    "rerank",
    "ocr",
    "local-first"
  ]
}
