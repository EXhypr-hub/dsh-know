{
  "name": "dsh-knowbase",
  "version": "0.3.0",
  "private": true,
  "description": "DSH 本地知识库插件：文档导入、语义检索、权威来源采集",
  "type": "module",
  "license": "MIT",
  "author": "EXhypr-hub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EXhypr-hub/dsh-know.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "scripts": {
    "selftest": "node scripts/selftest.mjs"
  },
  "optionalDependencies": {}
}
